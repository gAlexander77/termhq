---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
// import AppMock from "../components/AppMock.astro";
import { PRE_RELEASE } from "../config";

const features = [
  {
    title: "Panes, not tabs",
    body: "Open as many terminals as you need — the grid keeps growing to fit them. Tile them square or as full-height columns, and grow, move and swap them from the keyboard.",
  },
  {
    title: "Shells outlive the app",
    body: "Quit TermHQ entirely, reopen it, and your agents are still running where you left them — recent output intact. The tmux promise, without needing tmux.",
  },
  {
    title: "Workspaces",
    body: "Group terminals by project, each with its own layout and directories. Resume the last one automatically, or pick from a list on launch.",
  },
  {
    title: "Launch agents in one key",
    body: "Claude Code, Codex, OpenCode and Antigravity from a pane-header menu or a number key — with the flags you always use, and never listing one you have not installed.",
  },
  {
    title: "It taps your shoulder",
    body: "A pane that went quiet while you were looking elsewhere pulses, and says so — even parked out of sight. The hard part of running several agents is noticing when one stops.",
  },
  {
    title: "Agents render properly",
    body: "Agents that come up monochrome or misaligned elsewhere come up right here — full color, correct emoji and box-drawing widths, and panes sized before the first line is printed.",
  },
  {
    title: "A browser in the grid",
    body: "Ctrl+Shift+B tiles a real web page beside your shells — your OS's own browser engine, embedded, not a screenshot of one. Your docs, your dashboard, the localhost your agent is building, all in the layout you are already looking at.",
  },
  {
    title: "An editor in the grid",
    body: "Ctrl+Shift+E opens a pane that holds files as tabs, on the same engine VS Code uses. For the edit you make while something else is running — the config line the agent asked about, the fix that is faster to type than to explain.",
  },
  {
    title: "Your language servers, not ours",
    body: "Diagnostics, hover, completion, go-to-definition and formatting — from servers you install, at your version, obeying your repo's own config. TermHQ bundles none, so nothing here disagrees with your toolchain.",
  },
  {
    title: "Nothing gets lost",
    body: "Saves swap a temp file into place, so a failed one leaves the original intact. A file that changes underneath you asks rather than clobbers. And unsaved text is mirrored seconds after you stop typing, so a crash does not take it.",
  },
  {
    title: "Voice, locally transcribed",
    body: "Dictate into the focused terminal, transcribed on your own machine by local Whisper models. Models are a download you choose in Settings — English or sixteen other languages — so the app installs small and voice adds nothing until you want it.",
  },
  {
    title: "Closing is reversible",
    body: "A closed pane leaves a countdown you can click to bring it back. The shell keeps running underneath, so nothing is lost.",
  },
  {
    title: "Sized like a window",
    body: "Drag the boundary between two panes and it moves where you put it — panes touching it follow, panes that do not stay exactly where they were. A web page has a natural width and a terminal does not, so 70/30 is often the honest answer.",
  },
  {
    title: "Every shell you already have",
    body: "PowerShell, cmd, Git Bash and every WSL distribution on Windows; whatever /etc/shells reports on macOS. Detected on launch, so there is nothing to configure that the machine already knows.",
  },
  {
    title: "Source control, without leaving",
    body: "Review changes, stage files or individual hunks, commit exactly what is staged, browse history, switch branches, sync, stash and manage worktrees. Conflicts open in the editor with clear choices — or as a ready-made prompt for the AI you trust.",
  },
];

const keys = [
  { action: "New terminal", chord: ["Ctrl", "J"] },
  { action: "New browser pane", chord: ["Ctrl", "Shift", "B"] },
  { action: "New editor pane", chord: ["Ctrl", "Shift", "E"] },
  { action: "Command palette", chord: ["Ctrl", "Shift", "P"] },
  { action: "Run an agent by number", chord: ["Ctrl", "Shift", "A"] },
  { action: "Switch workspace", chord: ["Ctrl", "Shift", "W"] },
  { action: "Arrange panes", chord: ["Ctrl", "Shift", "G"] },
  { action: "Dictate into the focused pane", chord: ["Ctrl", "Alt", "Space"] },
  { action: "Copy — or interrupt when nothing is selected", chord: ["Ctrl", "C"] },
  { action: "Stash a pane, still running", chord: ["Ctrl", "Shift", "S"] },
  { action: "Read a markdown file, rendered", chord: ["Ctrl", "Shift", "V"] },
  { action: "Hand every key to the terminal", chord: ["Ctrl", "Shift", "U"] },
];
---

<Base>
  <section class="hero wrap">
    <Mark />
    {PRE_RELEASE && <span class="badge">Pre-release</span>}
    <h1>The terminal built for coding agents</h1>
    <p class="lede">
      Terminal emulators were designed for one person typing one command at a
      time. TermHQ runs as many agents as you want side by side — tiled so you
      can watch all of them, in shells that keep running after you quit.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/download/">Download</a>
      <a class="btn btn-lg" href="/docs/">Read the docs</a>
    </div>
    <ul class="hero-proof" aria-label="Product highlights">
      <li>Local-first</li>
      <li>Persistent sessions</li>
      <li>Windows and macOS</li>
    </ul>
    {
      PRE_RELEASE && (
        <p class="hero-note">
          Not publicly available yet. This site is a preview.
        </p>
      )
    }

    {/* <AppMock /> */}
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Built for agents</span>
        <h2>Made for how agents actually run</h2>
        <p>Long jobs, several at once, output you watch rather than read once.</p>
      </div>

      <div class="grid grid-3">
        {
          features.map((f) => (
            <div class="cell">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Keyboard-first</span>
        <h2>Your hands stay on the keys</h2>
        <p>Everything reachable without the mouse — and every chord rebindable.</p>
      </div>
      <div class="keys">
        {
          keys.map((k) => (
            <div class="keys-row">
              <span>{k.action}</span>
              <span>
                {k.chord.map((c) => (
                  <kbd>{c}</kbd>
                ))}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Make it yours</span>
        <h2>Settings you can search, files you can edit</h2>
        <p>
          A searchable settings panel for every option — and plain JSON
          underneath, for when you would rather just edit the file.
        </p>
      </div>
      <div class="grid grid-2">
        <div class="cell">
          <h3>Bring your theme</h3>
          <p>
            Ten built-ins from true black to true white, your own in one small
            JSON file, and one-click import for VS Code color themes from Open
            VSX. Themes now carry across the whole workbench and editor, while
            the terminal palette can still come from a different theme.
          </p>
        </div>
        <div class="cell">
          <h3>Every key rebindable</h3>
          <p>
            The whole keymap is yours, including an ultra-focus mode that hands
            every keystroke to the terminal so a TUI with its own chords gets
            them unmodified.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow">Under the hood</span>
      <h2>A Rust core, built for this app</h2>
      <p class="lede" style="margin:0 auto">
        Everything that touches your system — shells, sessions, files, git,
        speech — is native Rust, and the core is built from scratch: the
        session engine, the tiling grid, the theming system, Source Control.
        The interface renders in your OS's own webview
        instead of a bundled browser, which is why the installer is measured
        in megabytes, not hundreds of them.{" "}
        <a href="/docs/under-the-hood/">How it's built →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow">Windows · macOS</span>
      <h2>One download per platform</h2>
      <p class="lede" style="margin:0 auto 32px">
        No runtime to install first.
      </p>
      <a class="btn btn-primary btn-lg" href="/download/">Get TermHQ</a>
    </div>
  </section>
</Base>
