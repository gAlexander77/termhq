---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import AppMock from "../components/AppMock.astro";
import { PRE_RELEASE } from "../config";

const features = [
  {
    title: "Panes, not tabs",
    body: "Open as many terminals as you need — the grid keeps growing to fit them. Tile them square or as full-height columns, and grow, move and swap them from the keyboard.",
  },
  {
    title: "Shells outlive the app",
    body: "Quit TermHQ entirely, reopen it, and your agents are still running where you left them — recent output intact. The tmux promise, without needing tmux.",
  },
  {
    title: "Workspaces",
    body: "Group terminals by project, each with its own layout and directories. Resume the last one automatically, or pick from a list on launch.",
  },
  {
    title: "Launch agents in one key",
    body: "Claude Code, Codex, OpenCode and Antigravity from a pane-header menu or a number key — with the flags you always use, and never listing one you have not installed.",
  },
  {
    title: "It taps your shoulder",
    body: "A pane that went quiet while you were looking elsewhere pulses, and says so — even parked out of sight. The hard part of running several agents is noticing when one stops.",
  },
  {
    title: "Agents render properly",
    body: "Agents that come up monochrome or misaligned elsewhere come up right here — full color, correct emoji and box-drawing widths, and panes sized before the first line is printed.",
  },
  {
    title: "Voice, fully local",
    body: "Dictate into the focused terminal, transcribed on your own machine. Nothing is uploaded — there is no cloud path, by design. Speech models are a download you choose in Settings — English or sixteen other languages — so the app installs small and voice costs nothing until you want it.",
  },
  {
    title: "Closing is reversible",
    body: "A closed pane leaves a countdown you can click to bring it back. The shell keeps running underneath, so nothing is lost.",
  },
  {
    title: "Files and git, alongside",
    body: "A file tree that follows the focused pane's directory, and a source-control panel that goes well past staging — branches, syncing, conflicts, undo — so reviewing and shipping what an agent did does not mean leaving.",
  },
];

const keys = [
  { action: "New terminal", chord: ["Ctrl", "J"] },
  { action: "Command palette", chord: ["Ctrl", "Shift", "P"] },
  { action: "Run an agent by number", chord: ["Ctrl", "Shift", "A"] },
  { action: "Switch workspace", chord: ["Ctrl", "Shift", "W"] },
  { action: "Arrange panes", chord: ["Ctrl", "Shift", "G"] },
  { action: "Dictate into the focused pane", chord: ["Ctrl", "Alt", "Space"] },
  { action: "Copy — or interrupt when nothing is selected", chord: ["Ctrl", "C"] },
  { action: "Hand every key to the terminal", chord: ["Ctrl", "Shift", "U"] },
];
---

<Base>
  <section class="hero wrap">
    <Mark />
    {PRE_RELEASE && <span class="badge">Pre-release</span>}
    <h1>The terminal built for coding agents</h1>
    <p class="lede">
      Terminal emulators were designed for one person typing one command at a
      time. TermHQ runs as many agents as you want side by side — tiled so you
      can watch all of them, in shells that keep running after you quit.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/download/">Download</a>
      <a class="btn btn-lg" href="/docs/">Read the docs</a>
    </div>
    {
      PRE_RELEASE && (
        <p class="hero-note">
          Not publicly available yet. This site is a preview.
        </p>
      )
    }

    <AppMock />
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Built for agents</span>
        <h2>Made for how agents actually run</h2>
        <p>Long jobs, several at once, output you watch rather than read once.</p>
      </div>

      <div class="grid grid-3">
        {
          features.map((f) => (
            <div class="cell">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Keyboard-first</span>
        <h2>Your hands stay on the keys</h2>
        <p>Everything reachable without the mouse — and every chord rebindable.</p>
      </div>
      <div class="keys">
        {
          keys.map((k) => (
            <div class="keys-row">
              <span>{k.action}</span>
              <span>
                {k.chord.map((c) => (
                  <kbd>{c}</kbd>
                ))}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Make it yours</span>
        <h2>Settings you can search, files you can edit</h2>
        <p>
          A searchable settings panel for every option — and plain JSON
          underneath, for when you would rather just edit the file.
        </p>
      </div>
      <div class="grid grid-2">
        <div class="cell">
          <h3>Bring your theme</h3>
          <p>
            Ten built-ins from true black to true white, your own in one small
            JSON file, and one-click import for VS Code color themes from Open
            VSX. The terminal palette can follow the interface or come from a
            different theme entirely.
          </p>
        </div>
        <div class="cell">
          <h3>Every key rebindable</h3>
          <p>
            The whole keymap is yours, including an ultra-focus mode that hands
            every keystroke to the terminal so a TUI with its own chords gets
            them unmodified.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow">Windows · macOS · Linux</span>
      <h2>One download per platform</h2>
      <p class="lede" style="margin:0 auto 32px">
        No runtime to install first. No account. No telemetry to opt out of.
      </p>
      <a class="btn btn-primary btn-lg" href="/download/">Get TermHQ</a>
    </div>
  </section>
</Base>
