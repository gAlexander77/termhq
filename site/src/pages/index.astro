---
import Base from "../layouts/Base.astro";
import HomepageShortcuts from "../components/HomepageShortcuts.astro";
import AppScreenshots from "../components/AppScreenshots.astro";
// import AppMock from "../components/AppMock.astro";
import { PRE_RELEASE } from "../config";

const workflows = [
  {
    id: "parallel-agents",
    label: "Run agents together",
    title: "Keep every task in view.",
    body: "Launch your installed coding agents in separate panes. Arrange them around the work, and notice when an agent goes quiet and needs your attention.",
    guide: "agents",
    link: "Running coding agents",
  },
  {
    id: "persistent-work",
    label: "Pick up where you left off",
    title: "Close the window. Keep working.",
    body: "Your shells keep running when you quit TermHQ. Reopen it to reconnect with recent output intact, and organize each project in its own workspace.",
    guide: "persistent-sessions",
    link: "How persistent sessions work",
  },
  {
    id: "connected-tools",
    label: "Work in one place",
    title: "Code, preview, and review.",
    body: "Keep an editor and a live browser beside your terminals. Make a change, check your local preview, and review your diff without leaving the workspace.",
    guide: "panes-and-layout",
    link: "Build your workspace",
  },
];

const features = [
  { title: "Source control & worktrees", guide: "source-control", body: "Review changes, stage hunks, commit, and keep parallel branches organized." },
  { title: "Local voice dictation", guide: "configuration", body: "Dictate into a terminal with speech transcribed on your machine. Download a voice model when you need it." },
  { title: "Language assistance", guide: "language-servers", body: "Get completion, diagnostics, and navigation from the language servers you already use." },
  { title: "Recover your work", guide: "editor", body: "Restore unsaved editor text after a restart. Get a warning when a file changes outside TermHQ." },
  { title: "Your themes and shortcuts", guide: "theming", body: "Choose a built-in theme, import a VS Code color theme, and rebind shortcuts to suit your workflow." },
  { title: "Your existing shells", guide: "getting-started", body: "Use PowerShell, cmd, Git Bash, or WSL on Windows, and the shells installed on your Mac." },
];
---

<Base>
  <section class="landing-hero" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <img src="/hero-glass.webp" width="1536" height="1024" alt="" fetchpriority="high" decoding="async" />
    </div>
    <div class="wrap landing-hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">Your agents. One workspace.</span>
        {PRE_RELEASE && <span class="badge">Pre-release</span>}
        <h1 id="hero-title">The terminal built for coding agents.</h1>
        <p class="lede">
          Run your coding agents side by side. Keep terminals, your editor,
          and a browser in one workspace — with shells that keep running
          after you quit.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="/download/">
            Download TermHQ <span aria-hidden="true">↗</span>
          </a>
          <a class="btn btn-lg" href="#screenshots">Explore the workspace</a>
        </div>
        <ul class="hero-proof" aria-label="Product highlights">
          <li>Local-first</li>
          <li>Persistent sessions</li>
        </ul>
        {PRE_RELEASE && <p class="hero-note">Not publicly available yet. This site is a preview.</p>}
      </div>
    </div>
    {/* Keep the inaccurate application mock disabled. Use real captures below. */}
    {/* <AppMock /> */}
    <div class="wrap hero-caption">
      <span>Built for parallel work.</span>
      <a href="/download/">Windows / macOS <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <AppScreenshots />

  <section class="section" id="workflows" aria-labelledby="workflows-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The way you work</span>
        <h2 id="workflows-title">From the first command to the final change.</h2>
        <p>Three ways to keep your work moving, without switching context.</p>
      </div>
      <div class="workflow-grid">
        {workflows.map((workflow) => (
          <article class="workflow" id={workflow.id}>
            <span class="workflow-label">{workflow.label}</span>
            <h3>{workflow.title}</h3>
            <p>{workflow.body}</p>
            {/* Add this workflow's real recording here when it is available. */}
            <a class="text-link" href={`/docs/${workflow.guide}/`}>{workflow.link} <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="wrap">
      <div class="section-head section-head-compact">
        <span class="eyebrow">Everything around the terminal</span>
        <h2 id="features-title">The tools that keep you in flow.</h2>
      </div>
      <div class="grid grid-3 feature-grid">
        {features.map((feature) => (
          <a class="cell" href={`/docs/${feature.guide}/`}>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="shortcuts-title">
    <div class="wrap">
      <div class="section-head section-head-compact">
        <span class="eyebrow">Keyboard-first</span>
        <h2 id="shortcuts-title">Start with four shortcuts.</h2>
        <p>Open a pane or find a command. Rebind the keys whenever you want.</p>
      </div>
      <HomepageShortcuts />
      <p class="section-link"><a class="text-link" href="/docs/keyboard-shortcuts/">All shortcuts and platform details <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap closing-cta">
      <div>
        <span class="eyebrow">Windows · macOS</span>
        <h2>Make room for your next project.</h2>
        <p class="lede">Use the shells and tools you already have. A small download, with no separate runtime to set up.</p>
      </div>
      <div class="closing-actions">
        <a class="btn btn-primary btn-lg" href="/download/">Get TermHQ</a>
        <a class="text-link" href="/docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>
