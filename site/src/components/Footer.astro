---
import Mark from "./Mark.astro";
import { SITE, PRE_RELEASE } from "../config";
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Mark />
      <span>TermHQ</span>
    </div>

    <nav class="footer-links" aria-label="Footer">
      <a href="/docs/">Documentation</a>
      <a href="/docs/all/">All docs</a>
      <a href="/changelog/">Changelog</a>
      <a href="/download/">Download</a>
      <a href={SITE.repo} rel="noopener">GitHub</a>
    </nav>

    <p class="footer-note">
      {
        PRE_RELEASE
          ? "Pre-release. TermHQ is not publicly available yet."
          : "A terminal workbench for coding agents."
      }
    </p>
  </div>
</footer>
