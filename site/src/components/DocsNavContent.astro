---
interface NavItem {
  href: string;
  title: string;
}

interface Props {
  items: NavItem[];
  path: string;
}

const { items, path } = Astro.props;
const sections = [
  { title: "Getting started", slugs: ["", "getting-started", "installation"] },
  { title: "Workspace", slugs: ["panes-and-layout", "workspaces", "persistent-sessions", "worktrees"] },
  { title: "Tools", slugs: ["agents", "browser-panes", "editor", "language-servers", "source-control"] },
];
const docPath = (slug: string) => slug ? `/docs/${slug}/` : "/docs/";
const groupedPaths = new Set(sections.flatMap((section) => section.slugs.map(docPath)));
const groups = [
  ...sections.map((section) => ({
    title: section.title,
    items: items.filter((item) => section.slugs.some((slug) => item.href === docPath(slug))),
  })),
  // Newly added guides remain reachable even before they are assigned a group.
  { title: "Reference", items: items.filter((item) => !groupedPaths.has(item.href)) },
];
---

<div class="docs-nav-content">
  <div class="docs-side-head">
    <span class="docs-side-dot" aria-hidden="true"></span>
    <span>TermHQ documentation</span>
  </div>

  {groups.map((group) => (
    <div class="docs-nav-group">
      <h4>{group.title}</h4>
      <ul>
        {group.items.map((item) => (
          <li>
            <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="docs-nav-group docs-nav-reference">
    <h4>More</h4>
    <ul>
      <li>
        <a
          href="/docs/all/"
          aria-current={path === "/docs/all/" ? "page" : undefined}
        >
          All documentation
        </a>
      </li>
      <li><a href="/changelog/">Changelog</a></li>
    </ul>
  </div>
</div>
